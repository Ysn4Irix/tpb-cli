<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="0"
        android:pivotY="0"
        android:rotation="-45"
        android:translateX="54"
        android:translateY="54">
        <group android:translateX="-3.5">
            <!-- Horseshoe magnet body (Cyan Vector Magnet) -->
            <path
                android:pathData="M7,-8.2 L-4,-8.2 A8.2,8.2 0 0,0 -4,8.2 L7,8.2"
                android:strokeLineCap="butt"
                android:strokeLineJoin="round"
                android:strokeWidth="6.8">
                <aapt:attr name="android:strokeColor">
                    <gradient
                        android:endX="7"
                        android:endY="-8.2"
                        android:startX="-12"
                        android:startY="8.2"
                        android:type="linear">
                        <item android:color="#0284C7" android:offset="0.0" />
                        <item android:color="#0EA5E9" android:offset="0.5" />
                        <item android:color="#38BDF8" android:offset="1.0" />
                    </gradient>
                </aapt:attr>
            </path>

            <!-- Top machined pole cap -->
            <path
                android:fillColor="#F8FAFC"
                android:pathData="M8.5,-11.6 L13.4,-11.6 Q14.8,-11.6 14.8,-10.2 L14.8,-6.2 Q14.8,-4.8 13.4,-4.8 L8.5,-4.8 Z" />

            <!-- Bottom machined pole cap -->
            <path
                android:fillColor="#E2E8F0"
                android:pathData="M8.5,4.8 L13.4,4.8 Q14.8,4.8 14.8,6.2 L14.8,10.2 Q14.8,11.6 13.4,11.6 L8.5,11.6 Z" />

            <!-- Concentric cyan telemetry pulse arcs -->
            <path
                android:pathData="M18.8,-6.8 A11.8,11.8 0 0,1 18.8,6.8"
                android:strokeColor="#38BDF8"
                android:strokeLineCap="round"
                android:strokeWidth="2.3" />
            <path
                android:pathData="M23.0,-9.6 A16.8,16.8 0 0,1 23.0,9.6"
                android:strokeAlpha="0.65"
                android:strokeColor="#7DD3FC"
                android:strokeLineCap="round"
                android:strokeWidth="1.9" />
        </group>
    </group>
</vector>
